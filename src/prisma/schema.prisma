// Supermarket Staff & Work-Tracking System — Prisma schema
// Translated from the latest supermarket_schema.dbml:
//   - machine_employee_id lives on user_branches (clock-in machine numbers people PER BRANCH)
//   - users.phone is NOT NULL
//   - tasks target EXACTLY ONE of assigned_to (a person) OR assigned_role_id (a role)
//
// ON DELETE rules are intentionally NOT set here (they "live in the SQL").
// The tasks person-or-role XOR is a CHECK Prisma can't express — add it in a raw migration:
//   ALTER TABLE tasks ADD CONSTRAINT tasks_person_xor_role
//     CHECK (num_nonnulls(assigned_to, assigned_role_id) = 1);
// scheduled_vs_actual (FR6) is a VIEW; model separately or query raw.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum TaskStatus {
  pending
  completed
  verified
  rejected

  @@map("task_status")
}

enum TaskOrigin {
  assigned
  self

  @@map("task_origin")
}

enum AttendanceSource {
  csv_import
  machine
  manual

  @@map("attendance_source")
}

// ---------- Core ----------

model Role {
  roleId Int    @id @default(autoincrement()) @map("role_id")
  name   String @unique @db.VarChar

  users        User[]
  tasks        Task[] // tasks targeting this whole role (assigned_role_id)
  coverageReqs CoverageRequirement[]

  @@map("roles")
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  name         String   @db.VarChar
  phone        String   @unique @db.VarChar
  passwordHash String   @map("password_hash") @db.VarChar
  roleId       Int      @map("role_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  role Role @relation(fields: [roleId], references: [roleId])

  // back-relations
  branchLinks            UserBranch[]
  shifts                 Shift[]        @relation("ShiftWorker")
  shiftsCreated          Shift[]        @relation("ShiftCreator")
  attendance             Attendance[]
  importBatches          ImportBatch[]
  tasksAssigned          Task[]         @relation("TaskAssignee")
  tasksCreated           Task[]         @relation("TaskAssigner")
  taskInstancesCompleted TaskInstance[] @relation("TaskCompleter")
  taskInstancesReviewed  TaskInstance[] @relation("TaskReviewer")
  media                  Media[]

  @@map("users")
}

model Branch {
  branchId Int     @id @default(autoincrement()) @map("branch_id")
  name     String  @db.VarChar
  location String? @db.VarChar

  userBranches UserBranch[]
  registers    Register[]
  shifts       Shift[]
  attendance   Attendance[]
  tasks        Task[]
  shiftPeriods ShiftPeriod[]
  coverageReqs CoverageRequirement[]

  @@map("branches")
}

// many-to-many: which branches a person may work at / a manager can see.
// machine_employee_id lives here: the clock-in machine numbers people PER BRANCH.
model UserBranch {
  userId            Int     @map("user_id")
  branchId          Int     @map("branch_id")
  machineEmployeeId String? @map("machine_employee_id") @db.VarChar

  user   User   @relation(fields: [userId], references: [userId])
  branch Branch @relation(fields: [branchId], references: [branchId])

  @@id([userId, branchId])
  // clock-in ID unique within a branch; multiple NULLs allowed (Postgres)
  @@unique([branchId, machineEmployeeId])
  @@map("user_branches")
}

model Register {
  registerId Int    @id @default(autoincrement()) @map("register_id")
  branchId   Int    @map("branch_id")
  name       String @db.VarChar

  branch Branch  @relation(fields: [branchId], references: [branchId])
  shifts Shift[]

  // required so shifts can reference (branch_id, register_id) as a composite FK
  @@unique([branchId, registerId])
  @@map("registers")
}

model Shift {
  shiftId    Int      @id @default(autoincrement()) @map("shift_id")
  userId     Int      @map("user_id")
  branchId   Int      @map("branch_id")
  registerId Int?     @map("register_id") // NULL for non-cashier shifts
  periodId   Int?     @map("period_id") // named slot this shift was scheduled from, if any
  shiftDate  DateTime @map("shift_date") @db.Date
  startTime  DateTime @map("start_time") @db.Time
  endTime    DateTime @map("end_time") @db.Time
  createdBy  Int      @map("created_by") // manager who scheduled
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz // bumped on edit (FR2)

  user    User @relation("ShiftWorker", fields: [userId], references: [userId])
  creator User @relation("ShiftCreator", fields: [createdBy], references: [userId])

  branch Branch @relation(fields: [branchId], references: [branchId])

  // Composite FK: a cashier's register must live at the shift's own branch.
  // MATCH SIMPLE (Postgres default): when register_id is NULL the check is skipped.
  // branchId is shared with the Branch relation above — Prisma allows a scalar
  // field to participate in multiple relations.
  register Register? @relation(fields: [branchId, registerId], references: [branchId, registerId])

  // NOT a composite FK against (branchId, periodId): shift_periods.branch_id is nullable (a NULL
  // row applies chain-wide), so MATCH SIMPLE would let a period from any branch attach as long as
  // its branch_id happens to be NULL — it can't express "same branch, or global". The branch match
  // is an app-level check instead (see ShiftService.assertPeriodAtBranch).
  //
  // onDelete: Restrict overrides Prisma's own default (SetNull, since the relation is optional):
  // deleting a referenced period must be refused (409), not silently drop off the shifts scheduled
  // from it — see PeriodService.deletePeriod.
  period ShiftPeriod? @relation(fields: [periodId], references: [periodId], onDelete: Restrict)

  @@map("shifts")
}

// named slots a day is divided into ('Morning', 'Evening'), with the hours a shift in that slot
// normally runs. A NULL branch_id is the chain-wide default; a row naming a branch is that
// branch's own version of the slot.
model ShiftPeriod {
  periodId     Int      @id @default(autoincrement()) @map("period_id")
  branchId     Int?     @map("branch_id") // NULL = applies to all branches
  name         String   @db.VarChar // 'Morning', 'Evening'
  defaultStart DateTime @map("default_start") @db.Time
  defaultEnd   DateTime @map("default_end") @db.Time
  sortOrder    Int      @default(0) @map("sort_order")

  branch       Branch?               @relation(fields: [branchId], references: [branchId])
  requirements CoverageRequirement[]
  shifts       Shift[]

  @@map("shift_periods")
}

// how many people of a role a branch needs in a period — the target the schedule is measured
// against, every day of the week. A helper for building the schedule: nothing reads this table to
// create, block, or modify a shift.
model CoverageRequirement {
  requirementId Int @id @default(autoincrement()) @map("requirement_id")
  branchId      Int @map("branch_id")
  roleId        Int @map("role_id")
  periodId      Int @map("period_id")
  requiredCount Int @default(1) @map("required_count") // 0 is a real value: explicitly not needed

  branch Branch      @relation(fields: [branchId], references: [branchId])
  role   Role        @relation(fields: [roleId], references: [roleId])
  period ShiftPeriod @relation(fields: [periodId], references: [periodId])

  @@unique([branchId, roleId, periodId])
  @@map("coverage_requirements")
}

// one row per CSV/Excel upload from the clock-in machine (FR5 v1)
model ImportBatch {
  batchId    Int      @id @default(autoincrement()) @map("batch_id")
  fileName   String   @map("file_name") @db.VarChar
  importedBy Int      @map("imported_by")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz
  rowCount   Int      @default(0) @map("row_count")

  importer   User         @relation(fields: [importedBy], references: [userId])
  attendance Attendance[]

  @@map("import_batches")
}

model Attendance {
  attendanceId  Int              @id @default(autoincrement()) @map("attendance_id")
  userId        Int              @map("user_id")
  branchId      Int              @map("branch_id")
  clockIn       DateTime         @map("clock_in") @db.Timestamptz
  clockOut      DateTime?        @map("clock_out") @db.Timestamptz
  source        AttendanceSource @default(csv_import)
  importBatchId Int?             @map("import_batch_id") // NULL when source = manual

  user        User         @relation(fields: [userId], references: [userId])
  branch      Branch       @relation(fields: [branchId], references: [branchId])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [batchId])

  // re-uploading the same CSV must not duplicate rows
  @@unique([userId, clockIn])
  @@map("attendance")
}

// the task DEFINITION (one-off or recurring).
// Targets EXACTLY ONE of: a named person (assignedTo) OR a whole role (assignedRoleId).
model Task {
  taskId         Int        @id @default(autoincrement()) @map("task_id")
  title          String     @db.VarChar
  description    String?    @db.Text
  branchId       Int        @map("branch_id")
  assignedTo     Int?       @map("assigned_to") // named person; NULL when task targets a role
  assignedRoleId Int?       @map("assigned_role_id") // whole role; NULL when task targets a person
  assignedBy     Int        @map("assigned_by")
  origin         TaskOrigin @default(assigned)
  isRecurring    Boolean    @default(false) @map("is_recurring")
  recurrence     String?    @db.VarChar // 'daily', 'weekly:mon,wed'; NULL if one-off
  // "generates new instances and accepts new completions", NOT "exists". Flipping this to false
  // cancels the task's outstanding work: pending rows drop out of the daily list and completion
  // is refused (409). For a recurring task the daily job also deletes those pending rows, since
  // it can regenerate them if the task is switched back on; a one-off's instance is kept and
  // merely hidden, because nothing would ever recreate it. Instances already completed stay
  // visible and stay reviewable — the record of work that did happen is never rewritten.
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  branch     Branch @relation(fields: [branchId], references: [branchId])
  assignee   User?  @relation("TaskAssignee", fields: [assignedTo], references: [userId])
  assigner   User   @relation("TaskAssigner", fields: [assignedBy], references: [userId])
  targetRole Role?  @relation(fields: [assignedRoleId], references: [roleId])

  instances TaskInstance[]

  @@map("tasks")
}

// one row per occurrence — completion + verification live here
model TaskInstance {
  instanceId  Int        @id @default(autoincrement()) @map("instance_id")
  taskId      Int        @map("task_id")
  dueDate     DateTime   @map("due_date") @db.Date
  status      TaskStatus @default(pending)
  completedBy Int?       @map("completed_by")
  completedAt DateTime?  @map("completed_at") @db.Timestamptz
  reviewedBy  Int?       @map("reviewed_by") // manager who verified or rejected (FR9)
  reviewedAt  DateTime?  @map("reviewed_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  task      Task  @relation(fields: [taskId], references: [taskId])
  completer User? @relation("TaskCompleter", fields: [completedBy], references: [userId])
  reviewer  User? @relation("TaskReviewer", fields: [reviewedBy], references: [userId])

  media Media[]

  // one occurrence per task per day. Every instance insert goes through
  // ON CONFLICT DO NOTHING, so generation is idempotent: the daily top-up job
  // re-inserts the same 14-day window every run and this absorbs the overlap.
  @@unique([taskId, dueDate])
  @@map("task_instances")
}

// photo proof, attached to a specific completion
model Media {
  mediaId         Int      @id @default(autoincrement()) @map("media_id")
  taskInstanceId  Int      @map("task_instance_id")
  filePath        String   @map("file_path") @db.VarChar
  uploadedBy      Int      @map("uploaded_by")
  serverTimestamp DateTime @default(now()) @map("server_timestamp") @db.Timestamptz

  taskInstance TaskInstance @relation(fields: [taskInstanceId], references: [instanceId])
  uploader     User         @relation(fields: [uploadedBy], references: [userId])

  @@map("media")
}