# Local docker Postgres (docker compose up -d):
DATABASE_URL="postgresql://stafftrack:stafftrack_pass@localhost:5432/stafftrack"
# Supabase instead: DATABASE_URL = transaction pooler (port 6543, append ?pgbouncer=true) for the app,
# DIRECT_URL = session pooler (port 5432) for prisma migrate / db seed. URL-encode special characters
# in the password (e.g. ? -> %3F), or the URL won't parse.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Cloudflare R2 (S3 API) — task completion photos; see CLAUDE.md "Photo storage"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
