# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# task completion photos (local disk storage)
/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev log file (pino, dev only — see src/lib/logger.ts)
/logs/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# editor / agent tooling
.claude/
.vscode/

# personal working notes, not part of the codebase
/AUTH-RBAC-FEATURE.md
/TASK-FEATURE.md
/TO-BE-REVIEWED.md

# Playwright MCP session output (snapshots, console logs, screenshots)
/.playwright-mcp/
